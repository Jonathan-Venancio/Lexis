# SQLite is the local default.
DATABASE_URL=sqlite:///./data/lexis.db

# On the server, these four replace DATABASE_URL and connect to Postgres.
# DB_PORT defaults to 5432 when omitted.
# DB_HOST=nome-do-postgres
# DB_PORT=5432
# DB_NAME=lexis
# DB_USER=lexis
# DB_PASSWORD=senha

# Comma-separated browser origins allowed to call the API.
# The Docker image defaults to https://lexis.jonathanvenancio.site
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Secret used to sign login tokens. Set a long random value in production.
JWT_SECRET=lexis-dev-secret-change-in-production

# Gmail SMTP. Use an app password from the Google account, not the normal password.
# The API sends the reminders itself every few minutes when these three are set.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=voce@gmail.com
# SMTP_PASSWORD=senha-de-app
# SMTP_FROM=Lexis <voce@gmail.com>
# APP_URL=https://lexis.jonathanvenancio.site
# All reminder clocks use this timezone. Portugal is Europe/Lisbon.
# DEFAULT_TIMEZONE=Europe/Lisbon
